    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm pack --dry-run"
