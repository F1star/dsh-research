{
  "name": "@f1star/dsh-research",
  "version": "0.1.0",
  "description": "A DeepSeek Harness bundle for local PDF reading, durable paper records, traceable evidence, and cross-paper synthesis.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./research-document": {
      "types": "./lib/research-document/index.d.ts",
      "default": "./lib/research-document/index.js"
    },
    "./research-document/invariant": {
      "types": "./lib/research-document/invariant.d.ts",
      "default": "./lib/research-document/invariant.js"
    },
    "./research-document-pdfjs": {
      "types": "./lib/research-document-pdfjs/index.d.ts",
      "default": "./lib/research-document-pdfjs/index.js"
    },
    "./research-document-pdfjs/invariant": {
      "types": "./lib/research-document-pdfjs/invariant.d.ts",
      "default": "./lib/research-document-pdfjs/invariant.js"
    },
    "./research-library": {
      "types": "./lib/research-library/index.d.ts",
      "default": "./lib/research-library/index.js"
    },
    "./research-library/invariant": {
      "types": "./lib/research-library/invariant.d.ts",
      "default": "./lib/research-library/invariant.js"
    },
    "./research-information": {
      "types": "./lib/research-information/index.d.ts",
      "default": "./lib/research-information/index.js"
    },
    "./research-information/invariant": {
      "types": "./lib/research-information/invariant.d.ts",
      "default": "./lib/research-information/invariant.js"
    },
    "./tool-research-document": {
      "types": "./lib/tool-research-document/index.d.ts",
      "default": "./lib/tool-research-document/index.js"
    },
    "./tool-research-document/invariant": {
      "types": "./lib/tool-research-document/invariant.d.ts",
      "default": "./lib/tool-research-document/invariant.js"
    },
    "./tool-research-library": {
      "types": "./lib/tool-research-library/index.d.ts",
      "default": "./lib/tool-research-library/index.js"
    },
    "./tool-research-library/invariant": {
      "types": "./lib/tool-research-library/invariant.d.ts",
      "default": "./lib/tool-research-library/invariant.js"
    },
    "./tool-research-information": {
      "types": "./lib/tool-research-information/index.d.ts",
      "default": "./lib/tool-research-information/index.js"
    },
    "./tool-research-information/invariant": {
      "types": "./lib/tool-research-information/invariant.d.ts",
      "default": "./lib/tool-research-information/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm pack --dry-run"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "paper-reading",
    "literature-review",
    "evidence-synthesis"
  ],
  "homepage": "https://github.com/F1star/dsh-research#readme",
  "bugs": {
    "url": "https://github.com/F1star/dsh-research/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F1star/dsh-research.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-loader-smoke": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^24.10.1",
    "js-yaml": "^4.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
